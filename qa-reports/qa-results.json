  "defects": [
    {
      "id": "BUG-001",
      "title": "Interactive button onclick handlers fail with ReferenceError (openDestModal, closeModal, submitQuestion, scrollToTop)",
      "severity": "Critical",
      "priority": "P0",
      "module": "Core UI Interactivity",
      "steps": "1. Open application\n2. Click any \"View Details\" button (#btn-sigiriya)\n3. Check browser console",
      "expected": "Modal opens displaying destination details",
      "actual": "Uncaught ReferenceError: openDestModal is not defined. Modal does not open.",
      "evidence": "Console error: Uncaught ReferenceError: openDestModal is not defined",
      "file": "src/main.js:186 & index.html:140"
    },
    {
      "id": "BUG-002",
      "title": "Destination modal image source missing `/images/` directory prefix",
      "severity": "High",
      "priority": "P1",
      "module": "Destination Modal",
      "steps": "1. Open destination modal (e.g. for Sigiriya)\n2. Inspect modal <img> element src attribute\n3. Note 404 HTTP failure",
      "expected": "Modal displays destination image loaded from /images/sigiriya_rock_*.png",
      "actual": "Modal sets src=\"sigiriya_rock_*.png\" (relative to current path), resulting in 404 broken image",
      "evidence": "src/main.js line 195: imgHtml = `<img src=\"${data.img}\"...` instead of `/images/${data.img}`",
      "file": "src/main.js:195"
    },
    {
      "id": "BUG-003",
      "title": "Submitted Q&A community questions are not persisted (lost upon page refresh)",
      "severity": "High",
      "priority": "P1",
      "module": "Q&A Module",
      "steps": "1. Fill in question in Q&A form\n2. Submit question\n3. Reload page",
      "expected": "Submitted question persists and remains visible after page reload",
      "actual": "Question is prepended into in-memory DOM (#qa-dynamic-list) only and permanently vanishes on refresh",
      "evidence": "src/main.js lines 276-297: document.createElement & prepend into DOM without localStorage, indexedDB or backend API call",
      "file": "src/main.js:252-315"
    },
    {
      "id": "BUG-004",
      "title": "Incomplete HTML sanitization in escapeHtml: single quotes not encoded",
      "severity": "Medium",
      "priority": "P2",
      "module": "Security",
      "steps": "1. Submit input containing single quotes: ' onmouseover='alert(1)\n2. Inspect rendered DOM",
      "expected": "Single quote replaced by &#39; or &apos;",
      "actual": "Single quote preserved raw, creating potential XSS if injected into HTML attribute context",
      "evidence": "src/main.js lines 317-319: replace(/&/g, ...).replace(/</g, ...).replace(/>/g, ...).replace(/\"/g, ...)",
      "file": "src/main.js:317-319"
    },
    {
      "id": "BUG-005",
      "title": "Destination modal overlay lacks ARIA accessibility roles (role=\"dialog\", aria-modal=\"true\")",
      "severity": "Low",
      "priority": "P3",
      "module": "Accessibility",
      "steps": "1. Inspect #modal-overlay and #modal-box elements in DOM\n2. Check ARIA attributes",
      "expected": "Elements have role=\"dialog\" aria-modal=\"true\" aria-labelledby for screen readers",
      "actual": "No ARIA role or accessibility metadata defined on modal markup",
      "evidence": "index.html lines 1074-1079: <div class=\"modal-overlay\" id=\"modal-overlay\"...>",
      "file": "index.html:1074-1079"
    }
  ],
